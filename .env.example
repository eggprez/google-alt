# ---- Claude Code (required) ----
# Generate on any machine where you are logged into Claude Code with your subscription:
#   claude setup-token
# Paste the printed token here. It is a long-lived OAuth token tied to your Pro/Max plan.
CLAUDE_CODE_OAUTH_TOKEN=

# Model alias or full id used for the overview. sonnet is fast and good; opus is slower and better.
CLAUDE_MODEL=sonnet
# Max agent turns (searches + answer) per overview.
OVERVIEW_MAX_TURNS=12
# Kill an overview run after this long.
OVERVIEW_TIMEOUT_MS=150000
# Re-use an overview for the same query for this many seconds (0 disables the cache).
OVERVIEW_CACHE_TTL_S=3600
# Max concurrent Claude runs.
OVERVIEW_CONCURRENCY=2

# ---- Proxy ----
# Public URL of this service, used for absolute links and OpenSearch.
PUBLIC_ORIGIN=https://search.bindel.glass
PORT=8080
# Google host and locale used for fetching results.
GOOGLE_DOMAIN=www.google.com
GOOGLE_HL=en
GOOGLE_GL=us
# Send the requesting browser's User-Agent to Google so it returns markup meant for that browser.
FORWARD_CLIENT_UA=true
# How long to wait for Google's AI Overview to render before giving up on it (ms).
AIO_WAIT_MS=2500
# Xvfb screen size for the VNC login window.
SCREEN=1280x900x24
